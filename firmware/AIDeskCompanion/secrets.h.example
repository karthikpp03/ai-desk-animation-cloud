// Normally you do NOT write this by hand: run `npm run gen:firmware` in ../../cloud
// and it generates secrets.h here from the cloud project's .env.
// Manual alternative: copy this file to secrets.h (git-ignored) and fill it in.
#pragma once
#define SECRET_WIFI_SSID "your-wifi-name"
#define SECRET_WIFI_PASSWORD "your-wifi-password"
#define SECRET_API_BASE "https://your-worker.workers.dev"
#define SECRET_DEVICE_TOKEN "same-value-as-DEVICE_TOKEN-in-.env"
