# Copy to .env and fill in. .env is git-ignored; this example must never contain real values.
# Each value is entered ONCE, here. Scripts in /scripts read it; nothing else should contain these.

# --- Worker secrets (uploaded to Cloudflare with: npm run sync:secrets) ---
# Generate the two tokens yourself:  openssl rand -hex 32   (run it twice, one value for each)
ADMIN_TOKEN=
DEVICE_TOKEN=
# GitHub fine-grained token with "Contents: Read and write" on the animation repo only
GITHUB_TOKEN=github_pat starts like this 
# Optional (only used when the built-in parser cannot read an .ino file)
OPENAI_API_KEY=

# --- Worker configuration (not secret) ---
GITHUB_OWNER=user name enter here
GITHUB_REPO=repo name enter here
GITHUB_BRANCH=main or may be anyother branch name
# Your Worker URL, printed by `npm run deploy` (https://ai-desk-animation-api.<your-subdomain>.workers.dev)
API_BASE=https://your-worker.workers.dev

# --- ESP32 firmware (baked into secrets.h by: npm run gen:firmware) ---
# DEVICE_TOKEN and API_BASE above are reused. Wi-Fi credentials are generated into secrets.h.
HOME_WIFI_SSID=
HOME_WIFI_PASSWORD=
HOTSPOT_WIFI_SSID=
HOTSPOT_WIFI_PASSWORD=
# Legacy aliases accepted by gen:firmware for migration only:
# WIFI_SSID=
# WIFI_PASSWORD=
# Optional, used by the full AIDeskCompanion firmware only (weather screen):
WEATHER_API_KEY=
WEATHER_LOCATION=Chennai,IN
